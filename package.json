{
  "name": "portfoliopilot",
  "version": "0.84.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "native:build": "node scripts/build-native.mjs",
    "native:sync": "npm run native:build && cap sync",
    "native:ios:add": "npm run native:build && cap add ios --packagemanager SPM && node scripts/configure-ios-native.mjs && npm run native:ios:assets && npm run native:ios:verify",
    "native:ios:open": "cap open ios",
    "market:update": "node scripts/update-market-data.mjs && node scripts/update-etf-compositions.mjs && node scripts/update-material-events.mjs && node scripts/update-quarterly-financials.mjs && node scripts/update-benchmarks.mjs",
    "market:events": "node scripts/update-material-events.mjs",
    "market:quarterly": "node scripts/update-quarterly-financials.mjs",
    "market:benchmarks": "node scripts/update-benchmarks.mjs",
    "etf:update": "node scripts/update-etf-compositions.mjs",
    "history:update": "node scripts/update-price-history.mjs",
    "native:ios:configure": "node scripts/configure-ios-native.mjs",
    "native:ios:assets": "capacitor-assets generate --ios --assetPath assets --iconBackgroundColor '#1f332a' --iconBackgroundColorDark '#101412' --splashBackgroundColor '#1f332a' --splashBackgroundColorDark '#101412'",
    "native:ios:verify": "node scripts/verify-ios-packaging.mjs",
    "native:ios:archive:unsigned": "node scripts/archive-ios-unsigned.mjs",
    "native:ios:archive:verify": "node scripts/verify-ios-archive.mjs",
    "native:ios:testflight:options": "node scripts/create-testflight-export-options.mjs",
    "native:ios:archive:signed": "node scripts/archive-ios-signed.mjs",
    "native:ios:testflight:upload": "node scripts/upload-ios-testflight.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "@capacitor/assets": "^3.0.5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26"
  }
}
